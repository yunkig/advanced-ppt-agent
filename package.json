{
  "name": "advanced-ppt-agent",
  "version": "1.0.0",
  "description": "Industrial Full-Pipeline PPT Agent implementing Intent Routing, Adaptive RAG, HITL Plan & Template Confirmation, Leader-Worker Distributed Generation, and 4D Review Agent Quality Loop.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "demo": "tsx server/src/examples/demo-full-pipeline.ts"
  },
  "dependencies": {
    "express": "^4.22.2",
    "mammoth": "^1.8.0",
    "marked": "^14.1.0",
    "pptxgenjs": "^3.12.0",
    "vue": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
